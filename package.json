{
  "name": "quickink-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter user-app --filter admin-app dev",
    "dev:user": "pnpm --filter user-app dev",
    "dev:admin": "pnpm --filter admin-app dev",
    "dev:desktop": "pnpm --filter quickink-desktop start",
    "desktop:install": "pnpm --filter quickink-desktop install",
    "desktop:dev": "pnpm --filter quickink-desktop start",
    "build": "pnpm --filter user-app --filter admin-app build",
    "build:user": "pnpm --filter user-app build",
    "build:admin": "pnpm --filter admin-app build"
  }
}
